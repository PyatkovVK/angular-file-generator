{
    "name": "angFG",
    "displayName": "Angular File Generator",
    "description": "Angular file generator for project Program engineering",
    "repository": "https://github.com/ChocolateHacker/angular-file-generator",
    "version": "0.1.1",
    "engines": {
        "vscode": "^1.96.0"
    },
    "scripts": {
        "install_project": "npm i && npm run pack:plugin",
        "npm i": "npm i",
        "pack:plugin": "vsce package",
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:angFG.generateComponent",
        "onCommand:angFG.generateModule",
        "onCommand:angFG.generateService",
        "onCommand:angFG.generateDirective"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "angFG.generateComponent",
                "title": "Generate Angular Component"
            },
            {
                "command": "angFG.generateModule",
                "title": "Generate Angular Module"
            },
            {
                "command": "angFG.generateService",
                "title": "Generate Angular Service"
            },
            {
                "command": "angFG.generateDirective",
                "title": "Generate Angular Directive"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "angFG.generateComponent",
                    "group": "1_angFG@1"
                },
                {
                    "command": "angFG.generateModule",
                    "group": "1_angFG@2"
                },
                {
                    "command": "angFG.generateService",
                    "group": "1_angFG@3"
                },
                {
                    "command": "angFG.generateDirective",
                    "group": "1_angFG@4"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/mocha": "10.0.10",
        "@types/node": "20.x",
        "@types/vscode": "1.96.0",
        "@typescript-eslint/eslint-plugin": "8.17.0",
        "@typescript-eslint/parser": "8.17.0",
        "eslint": "9.16.0",
        "typescript": "5.7.2"
    },
    "dependencies": {
        "vsce": "2.15.0"
    }
}